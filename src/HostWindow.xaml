<Window x:Class="WindowMerger.HostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口合并 WindowMerger"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MinWidth="400"
        MinHeight="300">

    <!-- CaptionHeight=0：顶条走 DragMove，右键才能弹自定义菜单；缩放交给 WindowChrome 的 resize 边 -->
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8"
                      CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 顶条/格子配色由 ApplyTheme 按当前主题刷（XAML 值仅深色主题初值） -->
    <Border x:Name="_outer" BorderBrush="#3A3A3A" BorderThickness="2">
        <DockPanel LastChildFill="True">
            <Border x:Name="_topBar" DockPanel.Dock="Top" Height="28" Background="#202020">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="_appIcon" Grid.Column="0" Width="16" Height="16"
                           Margin="8,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="_appLabel" Grid.Column="1" Text="WindowMerger"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"
                               VerticalAlignment="Center" Foreground="#D8D8D8" />
                    <TextBlock x:Name="_status" Grid.Column="2" FontSize="12" Margin="0,0,10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="#D8D8D8" />
                    <!-- 顶条功能组按钮由 code-behind 的 CaptionButton 工厂填充 -->
                    <StackPanel x:Name="_captionButtons" Grid.Column="3"
                                Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Stretch" Background="{x:Null}" />
                </Grid>
            </Border>
            <Grid x:Name="_content" Background="{x:Null}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="_leftCol" Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="_leftPaneBorder" Grid.Column="0" Background="{x:Null}"
                        BorderBrush="#3A3A3A" BorderThickness="2">
                    <Grid Background="{x:Null}">
                        <!-- 拖放目标高亮（拖动中亮起） -->
                        <Border x:Name="_leftGlow" BorderBrush="#0A84FF" BorderThickness="5"
                                CornerRadius="4" Margin="1" IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>
                <Border x:Name="_divider" Grid.Column="1" Width="8" Cursor="SizeWE"
                        Background="#3C3C3C" />
                <Border x:Name="_rightPaneBorder" Grid.Column="2" Background="{x:Null}"
                        BorderBrush="#3A3A3A" BorderThickness="2">
                    <Grid Background="{x:Null}">
                        <Border x:Name="_rightGlow" BorderBrush="#0A84FF" BorderThickness="5"
                                CornerRadius="4" Margin="1" IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
