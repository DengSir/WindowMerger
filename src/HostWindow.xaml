<Window x:Class="WindowMerger.HostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口合并 WindowMerger"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        MinWidth="400"
        MinHeight="300">
    <!-- UseLayoutRounding：所有元素边缘吸附到整数设备像素。分隔条 x = 2+avail*ratio 是
         分数 DIP（缩放宿主后 ActualWidth 非整数），150% 屏上 ×1.5 落在分数物理像素 →
         边缘列半透明，隔着子窗隐形边透出后面的窗口 = 分隔条左右各一条"透明缝"；
         250ms 维护定时器不触发 WPF 重绘无法自愈，拖分隔条强制重布局才恢复（用户实测）。
         吸附取整后与子窗放置公式 Round(PointToScreen) 同一舍入，缝隙类整体消除。
         另修复同类旧账：1 DIP 边框在 150%=1.5px 的 AA 发丝线（AGENTS 已记录，边框因此
         加宽到 2 DIP，但位置分数时 2 DIP 仍会出半列）。 -->


    <Window.Resources>
        <!-- 内嵌字体（pack URI 必须经 XAML 声明，代码 new FontFamily 渲染不解析） -->
        <FontFamily x:Key="FaSolid">pack://application:,,,/assets/fa-solid-900.ttf#Font Awesome 6 Free Solid</FontFamily>
        <!-- 系统标题栏图标（ChromeMinimize/Maximize/Restore/Close）：按名引用 Windows 自带
             字体——微软系统字体不可内嵌再分发；Win10 无 Fluent 时回退 MDL2 同码位 -->
        <FontFamily x:Key="CaptionIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- 主题刷色：ApplyTheme 在启动/切主题时替换这些资源值，DynamicResource 自动传播 -->
        <SolidColorBrush x:Key="ThemeBarBrush" Color="#202020" />
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="ThemeDividerBrush" Color="#3C3C3C" />
        <SolidColorBrush x:Key="ThemeDividerHoverBrush" Color="#2B5B8F" />
        <SolidColorBrush x:Key="ThemeTextBrush" Color="#D8D8D8" />
        <SolidColorBrush x:Key="ThemeButtonHoverBrush" Color="#3C3C3C" />
        <SolidColorBrush x:Key="ThemeDangerHoverBrush" Color="#C42B1C" />

        <!-- 顶条按钮共用外观（极简模板：Border + Content）；悬停刷色走 Trigger + DynamicResource
             （实测 .NET 10 WPF 可用），切主题由资源替换自动传播 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="FontFamily" Value="{StaticResource FaSolid}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 关闭按钮：悬停红色系（其余继承隐式按钮样式） -->
        <Style x:Key="DangerCaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeDangerHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tooltip：默认样式用系统配色（白底黑字）不随主题，整体替换为极简模板走主题刷色
             （隐式样式经 Owner 的资源链查到本窗口资源，DynamicResource 随 ApplyTheme 换色） -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ThemeBarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="8,5">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分隔条：悬停高亮（取代旧 MouseEnter/MouseLeave 事件刷色） -->
        <Style x:Key="DividerStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeDividerBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeDividerHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- CaptionHeight=0：顶条走 DragMove，右键才能弹自定义菜单；缩放交给 WindowChrome 的 resize 边 -->
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8"
                      CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 主题刷色由 ApplyTheme 换上面的资源完成（XAML 值仅深色主题初值） -->
    <Border x:Name="_outer" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="2">
        <!-- 单格叠层：_content 铺满整窗，_topBar 浮在其上（树序后者渲染在上）。
             非最大化由 code-behind 给 _content 上边距=_topBarH（顶条占位，视觉同旧 DockPanel）；
             最大化走自动隐藏浮层：TopInset=0 子窗占满全高，顶条移入显示时盖在子窗上方 -->
        <Grid>
            <Grid x:Name="_content" Background="{x:Null}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="_leftCol" Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="_leftPaneBorder" Grid.Column="0" Background="{x:Null}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="2">
                    <Grid Background="{x:Null}">
                        <!-- 空格占位：填充不透明 + 提示文案（该侧吸附后隐藏，恢复透明让子窗口透出） -->
                        <Border x:Name="_leftHint" Background="{DynamicResource ThemeBarBrush}"
                                Visibility="Collapsed">
                            <TextBlock Text="拖窗口到此处吸附&#x000A;或点顶条 ← 选择左窗"
                                       FontSize="13" TextAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- 拖放目标高亮（拖动中亮起，盖在占位上） -->
                        <Border x:Name="_leftGlow" BorderBrush="#0A84FF" BorderThickness="5"
                                CornerRadius="4" Margin="1" IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>
                <Border x:Name="_divider" Grid.Column="1" Cursor="SizeWE"
                        Style="{StaticResource DividerStyle}">
                    <TextBlock x:Name="_gripText" Text="&#xF338;"
                               FontFamily="{StaticResource FaSolid}" FontSize="9"
                               Foreground="#70FFFFFF" HorizontalAlignment="Center"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Border>
                <Border x:Name="_rightPaneBorder" Grid.Column="2" Background="{x:Null}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="2">
                    <Grid Background="{x:Null}">
                        <!-- 空格占位：填充不透明 + 提示文案（该侧吸附后隐藏，恢复透明让子窗口透出） -->
                        <Border x:Name="_rightHint" Background="{DynamicResource ThemeBarBrush}"
                                Visibility="Collapsed">
                            <TextBlock Text="拖窗口到此处吸附&#x000A;或点顶条 → 选择右窗"
                                       FontSize="13" TextAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="_rightGlow" BorderBrush="#0A84FF" BorderThickness="5"
                                CornerRadius="4" Margin="1" IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
            <!-- 顶条浮层：树序在 _content 之后 = 渲染在其上。最大化自动隐藏（移入显示，
                 _barSlide 滑入滑出，子窗口内容从顶条下面透出）；非最大化恒显示。
                 外框 Border 常驻包裹、厚度由 ApplyTopBarMode 切换：正常态 0（外观由宿主
                 _outer 外框负责）；浮层态 2 DIP 四边框——框画在 _topBar 外面，
                 _topBar.Height 恒 28，底色带视觉高度与正常态一致 -->
            <Border x:Name="_topBarFrame" VerticalAlignment="Top"
                    BorderBrush="{DynamicResource ThemeBorderBrush}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="_barSlide" Y="0" />
                </Border.RenderTransform>
                <Border x:Name="_topBar" Height="28"
                        Background="{DynamicResource ThemeBarBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="_appIcon" Grid.Column="0" Width="16" Height="16"
                           Margin="8,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="_appLabel" Grid.Column="1" Text="WindowMerger"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextBrush}" />
                    <TextBlock x:Name="_status" Grid.Column="2" FontSize="12" Margin="0,0,10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ThemeTextBrush}" />
                    <!-- 顶条功能组：[发现新版本][⬇（更新）][左][右][释放][交换][快捷方式][主题] | [─][□][✕]
                         更新组只在发现新版本时现身（SetUpdatePhase 控制显隐）；其余字形内容/点击/悬停刷色由 code-behind 补齐 -->
                    <StackPanel x:Name="_captionButtons" Grid.Column="3"
                                Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Stretch" Background="{x:Null}">
                        <!-- 更新组：文案 + 下载按钮。发现新版本自动弹确认框（一次性宣告），
                             点 ⬇ 直接下载安装不再询问。AutomationId 供 e2e 测试 UIA 定位 -->
                        <TextBlock x:Name="_updateLabel" Text="发现新版本" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,2,0"
                                   Foreground="{DynamicResource ThemeTextBrush}"
                                   Visibility="Collapsed" />
                        <Button x:Name="_updateButton" Width="30" Margin="0,0,6,0" Visibility="Collapsed"
                                ToolTip="发现新版本" AutomationProperties.AutomationId="UpdateButton">&#xF019;</Button>
                        <Button x:Name="_pickLeftButton" Width="30" ToolTip="选择左窗…"
                                RenderTransformOrigin="0.5,0.5">&#xF060;</Button>
                        <Button x:Name="_pickRightButton" Width="30" ToolTip="选择右窗…">&#xF061;</Button>
                        <Button x:Name="_releaseButton" Width="30" ToolTip="全部释放（窗口回到原位）">&#xF127;</Button>
                        <Button x:Name="_swapButton" Width="30" ToolTip="交换左右">&#xF0EC;</Button>
                        <Button x:Name="_shortcutButton" Width="30" ToolTip="为当前吸附组合创建桌面快捷方式">&#xF360;</Button>
                        <Button x:Name="_themeButton" Width="30" />
                        <Border Width="1" Margin="4,6,4,6" Background="#4A4A4A"
                                VerticalAlignment="Stretch" />
                        <!-- 系统钮三件套用 CaptionIcons 原版字形（E921/E922/E923/E8BB = Windows
                             标题栏自渲染字形），FontSize 10 = Fluent 设计尺寸 -->
                        <Button x:Name="_minimizeButton" ToolTip="最小化"
                                FontFamily="{StaticResource CaptionIcons}" FontSize="10">&#xE921;</Button>
                        <Button x:Name="_maxButton" ToolTip="最大化"
                                FontFamily="{StaticResource CaptionIcons}" FontSize="10">&#xE922;</Button>
                        <Button x:Name="_closeButton" Style="{StaticResource DangerCaptionButton}"
                                FontFamily="{StaticResource CaptionIcons}" FontSize="10" ToolTip="关闭">&#xE8BB;</Button>
                    </StackPanel>
                </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
