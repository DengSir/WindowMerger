<Window x:Class="WindowMerger.HostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口合并 WindowMerger"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MinWidth="400"
        MinHeight="300">

    <Window.Resources>
        <!-- 内嵌字体（pack URI 必须经 XAML 声明，代码 new FontFamily 渲染不解析） -->
        <FontFamily x:Key="FaSolid">pack://application:,,,/assets/fa-solid-900.ttf#Font Awesome 6 Free Solid</FontFamily>
        <FontFamily x:Key="FaRegular">pack://application:,,,/assets/fa-regular-400.ttf#Font Awesome 6 Free Regular</FontFamily>

        <!-- 主题刷色：ApplyTheme 在启动/切主题时替换这些资源值，DynamicResource 自动传播 -->
        <SolidColorBrush x:Key="ThemeBarBrush" Color="#202020" />
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="ThemeDividerBrush" Color="#3C3C3C" />
        <SolidColorBrush x:Key="ThemeDividerHoverBrush" Color="#2B5B8F" />
        <SolidColorBrush x:Key="ThemeTextBrush" Color="#D8D8D8" />
        <SolidColorBrush x:Key="ThemeButtonHoverBrush" Color="#3C3C3C" />
        <SolidColorBrush x:Key="ThemeDangerHoverBrush" Color="#C42B1C" />

        <!-- 顶条按钮共用外观（极简模板：Border + Content）；悬停刷色走 Trigger + DynamicResource
             （实测 .NET 10 WPF 可用），切主题由资源替换自动传播 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="FontFamily" Value="{StaticResource FaSolid}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 关闭按钮：悬停红色系（其余继承隐式按钮样式） -->
        <Style x:Key="DangerCaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeDangerHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 分隔条：悬停高亮（取代旧 MouseEnter/MouseLeave 事件刷色） -->
        <Style x:Key="DividerStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeDividerBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeDividerHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- CaptionHeight=0：顶条走 DragMove，右键才能弹自定义菜单；缩放交给 WindowChrome 的 resize 边 -->
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8"
                      CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 主题刷色由 ApplyTheme 换上面的资源完成（XAML 值仅深色主题初值） -->
    <Border x:Name="_outer" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="2">
        <DockPanel LastChildFill="True">
            <Border x:Name="_topBar" DockPanel.Dock="Top" Height="28"
                    Background="{DynamicResource ThemeBarBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="_appIcon" Grid.Column="0" Width="16" Height="16"
                           Margin="8,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="_appLabel" Grid.Column="1" Text="WindowMerger"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextBrush}" />
                    <TextBlock x:Name="_status" Grid.Column="2" FontSize="12" Margin="0,0,10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ThemeTextBrush}" />
                    <!-- 顶条功能组：[左][右][交换][释放][主题] | [─][□][✕]
                         字形内容/点击/悬停刷色由 code-behind 补齐 -->
                    <StackPanel x:Name="_captionButtons" Grid.Column="3"
                                Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Stretch" Background="{x:Null}">
                        <Button x:Name="_pickLeftButton" Width="30" ToolTip="选择左窗…">&#xF060;</Button>
                        <Button x:Name="_pickRightButton" Width="30" ToolTip="选择右窗…">&#xF061;</Button>
                        <Button x:Name="_swapButton" Width="30" ToolTip="交换左右">&#xF0EC;</Button>
                        <Button x:Name="_releaseButton" Width="30" ToolTip="全部释放（窗口回到原位）">&#xF127;</Button>
                        <Button x:Name="_themeButton" Width="30" />
                        <Border Width="1" Margin="4,6,4,6" Background="#4A4A4A"
                                VerticalAlignment="Stretch" />
                        <Button x:Name="_minimizeButton" ToolTip="最小化">&#xF068;</Button>
                        <Button x:Name="_maxButton" ToolTip="最大化"
                                FontFamily="{StaticResource FaRegular}">&#xF096;</Button>
                        <Button x:Name="_closeButton" Style="{StaticResource DangerCaptionButton}"
                                FontSize="16" ToolTip="关闭">&#xF00D;</Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="_content" Background="{x:Null}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="_leftCol" Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="_leftPaneBorder" Grid.Column="0" Background="{x:Null}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1,2,1,1">
                    <Grid Background="{x:Null}">
                        <!-- 拖放目标高亮（拖动中亮起） -->
                        <Border x:Name="_leftGlow" BorderBrush="#0A84FF" BorderThickness="5"
                                CornerRadius="4" Margin="1" IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>
                <Border x:Name="_divider" Grid.Column="1" Cursor="SizeWE"
                        Style="{StaticResource DividerStyle}">
                    <TextBlock x:Name="_gripText" Text="&#xF338;"
                               FontFamily="{StaticResource FaSolid}" FontSize="9"
                               Foreground="#70FFFFFF" HorizontalAlignment="Center"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Border>
                <Border x:Name="_rightPaneBorder" Grid.Column="2" Background="{x:Null}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1,2,1,1">
                    <Grid Background="{x:Null}">
                        <Border x:Name="_rightGlow" BorderBrush="#0A84FF" BorderThickness="5"
                                CornerRadius="4" Margin="1" IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
