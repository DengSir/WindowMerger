<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml" />
    <Page Remove="src\App.xaml" />
    <None Remove="Resources\fa-*.ttf" />
    <Content Include="Resources\fa-solid-900.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\fa-regular-400.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\WindowMerger.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WindowMerger</RootNamespace>
    <AssemblyName>WindowMerger</AssemblyName>
    <ApplicationIcon>assets\WindowMerger.ico</ApplicationIcon>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>WindowMerger</Product>
    <AssemblyTitle>WindowMerger</AssemblyTitle>
  </PropertyGroup>

</Project>
